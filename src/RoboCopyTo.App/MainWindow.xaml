<Window x:Class="RoboCopyTo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:RoboCopyTo.App.Controls"
        xmlns:vm="clr-namespace:RoboCopyTo.App.ViewModels"
        xmlns:o="clr-namespace:RoboCopyTo.Core.Options;assembly=RoboCopyTo.Core"
        Title="{Binding WindowTitle}"
        Width="920" Height="900" MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ToolTipService.InitialShowDelay="400"
        ToolTipService.ShowDuration="20000">
    <Window.Resources>
        <c:BoolToVisibility x:Key="Vis" />
        <c:TextToVisibility x:Key="TextVis" />
        <c:ZeroToVisibility x:Key="ZeroVis" />
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Shield" TargetType="TextBlock">
            <Setter Property="Text" Value="&#xEA18;" />
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            <Setter Property="ToolTip" Value="{x:Static o:OptionHelp.Elevation}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,8,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,0,20,4" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="72" />
        </Style>
    </Window.Resources>

    <Grid Margin="16,12,16,14">

        <!-- ═════════════════════════ EDIT ═════════════════════════ -->
        <Grid Visibility="{Binding IsEditMode, Converter={StaticResource Vis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>

                    <!-- 1. Selected items -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding ItemsHeader}" />
                            <ListBox x:Name="ItemsList" ItemsSource="{Binding Items}" MaxHeight="170" MinHeight="40"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     AutomationProperties.Name="Selected items">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="8,2" />
                                        <Setter Property="MinHeight" Value="34" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Path}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SelectedItemViewModel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="16"
                                                       VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{Binding KindText}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Path}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                            <Button Grid.Column="2" MinWidth="0" Padding="8,4"
                                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Remove this item from the copy"
                                                    AutomationProperties.Name="{Binding Path, StringFormat=Remove {0}}">
                                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="11" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- 2. Destination -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Destination" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DestinationBox" Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                         VerticalContentAlignment="Center"
                                         ToolTip="The folder everything is copied into. Each selected folder lands in a subfolder with its own name; files land directly in it."
                                         AutomationProperties.Name="Destination folder" />
                                <Button Grid.Column="1" Command="{Binding BrowseCommand}" ToolTip="Choose the destination folder" AutomationProperties.Name="Browse">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <AccessText Text="_Browse" />
                                    </StackPanel>
                                </Button>
                                <!-- Recent destinations: a drop-down menu, so arrow keys browse the list without picking. -->
                                <Button x:Name="RecentButton" Grid.Column="2" MinWidth="110" Click="RecentButton_Click"
                                        ToolTip="Pick one of your 10 most recent destinations" AutomationProperties.Name="Recent destinations">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Recent" />
                                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="RecentMenu" ItemsSource="{Binding RecentDestinations}">
                                            <ContextMenu.ItemContainerStyle>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Setter Property="Header" Value="{Binding}" />
                                                    <Setter Property="Command" Value="{Binding DataContext.UseRecentDestinationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                                </Style>
                                            </ContextMenu.ItemContainerStyle>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </Grid>
                            <TextBlock Style="{StaticResource Note}" Margin="0,6,0,0" Text="{Binding FftNote}"
                                       Visibility="{Binding IsDestinationFat, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </Border>

                    <!-- 3. Preset -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Preset" />
                            <WrapPanel>
                                <ComboBox Width="240" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                                          DisplayMemberPath="Name" AutomationProperties.Name="Preset"
                                          ToolTip="Choose a saved set of options. Built-in presets can be copied with Save as." />
                                <TextBlock Text="{Binding PresetStateText}" VerticalAlignment="Center" Margin="8,0,8,0" FontStyle="Italic"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Button Content="Save" Command="{Binding SavePresetCommand}" ToolTip="Save the current options into this preset (custom presets only)" />
                                <Button Content="Save _as" Command="{Binding SavePresetAsCommand}" ToolTip="Save the current options as a new preset" />
                                <Button Content="Delete" Command="{Binding DeletePresetCommand}" ToolTip="Delete this preset (custom presets only)" />
                                <Button Content="Re_vert" Command="{Binding RevertPresetCommand}" ToolTip="Discard changes and go back to this preset's options" />
                                <CheckBox Content="Default" IsChecked="{Binding IsDefaultPreset}" Margin="14,0,0,0" VerticalAlignment="Center"
                                          ToolTip="Open the dialog with this preset. Without a default, the last used preset opens." />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 4. Main options -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Main options" />
                            <WrapPanel>
                                <CheckBox Content="{x:Static o:OptionLabels.IncludeSubfolders}" IsChecked="{Binding DisplayIncludeSubfolders}"
                                          IsEnabled="{Binding IsIncludeSubfoldersEnabled}" ToolTip="{Binding IncludeSubfoldersToolTip}" />
                                <CheckBox Content="{x:Static o:OptionLabels.Mirror}" IsChecked="{Binding Mirror}" IsEnabled="{Binding IsMirrorEnabled}"
                                          ToolTip="{Binding MirrorToolTip}" />
                                <CheckBox Content="{x:Static o:OptionLabels.Restartable}" IsChecked="{Binding Restartable}" IsEnabled="{Binding IsRestartableEnabled}"
                                          ToolTip="{Binding RestartableToolTip}" />
                                <CheckBox Content="{x:Static o:OptionLabels.Unbuffered}" IsChecked="{Binding Unbuffered}" ToolTip="{x:Static o:OptionHelp.Unbuffered}" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <CheckBox Content="{x:Static o:OptionLabels.Multithreaded}" IsChecked="{Binding Multithreaded}" Margin="0,0,8,0"
                                              ToolTip="{x:Static o:OptionHelp.Multithreaded}" />
                                    <c:NumberBox Value="{Binding Threads}" Minimum="1" Maximum="128" IsEnabled="{Binding Multithreaded}"
                                                 ToolTip="{x:Static o:OptionHelp.Threads}" AutomationProperties.Name="Threads" />
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 5. Existing files -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Existing files" />
                            <ComboBox Width="260" HorizontalAlignment="Left" ItemsSource="{Binding ExistingModes}"
                                      SelectedValuePath="Mode" SelectedValue="{Binding ExistingFiles}" DisplayMemberPath="Name"
                                      ToolTip="{Binding SelectedItem.ToolTip, RelativeSource={RelativeSource Self}}"
                                      AutomationProperties.Name="Existing files">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                        <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- 6. Retries -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Retries" />
                            <WrapPanel>
                                <Label Style="{StaticResource FieldLabel}" Content="{x:Static o:OptionLabels.RetryCount}" Target="{Binding ElementName=RetryCountBox}" />
                                <c:NumberBox x:Name="RetryCountBox" Value="{Binding DisplayRetryCount}" Minimum="0" Maximum="1000000" Margin="0,0,20,4"
                                             IsEnabled="{Binding AreRetrySpinnersEnabled}"
                                             ToolTip="{x:Static o:OptionHelp.RetryCount}" AutomationProperties.Name="Retry count" />
                                <Label Style="{StaticResource FieldLabel}" Content="{x:Static o:OptionLabels.RetryWait}" Target="{Binding ElementName=RetryWaitBox}" />
                                <c:NumberBox x:Name="RetryWaitBox" Value="{Binding DisplayRetryWait}" Minimum="0" Maximum="86400" Margin="0,0,20,4"
                                             IsEnabled="{Binding AreRetrySpinnersEnabled}"
                                             ToolTip="{x:Static o:OptionHelp.RetryWait}" AutomationProperties.Name="Wait seconds" />
                                <CheckBox Content="{x:Static o:OptionLabels.NetworkFriendly}" IsChecked="{Binding NetworkFriendly}" VerticalAlignment="Center"
                                          ToolTip="{x:Static o:OptionHelp.NetworkFriendly}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 7. Advanced -->
                    <Border Margin="0,0,0,10">
                        <Expander Header="Advanced" IsExpanded="{Binding IsAdvancedExpanded}" FontSize="15" FontWeight="SemiBold">
                            <StackPanel Margin="0,8,0,0" TextElement.FontSize="14" TextElement.FontWeight="Normal">
                                <WrapPanel>
                                    <CheckBox Content="{x:Static o:OptionLabels.CopyPermissions}" IsChecked="{Binding CopyPermissions}"
                                              ToolTip="{x:Static o:OptionHelp.CopyPermissions}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                                        <CheckBox Content="{x:Static o:OptionLabels.CopyOwner}" IsChecked="{Binding CopyOwner}" Margin="0"
                                                  ToolTip="{x:Static o:OptionHelp.CopyOwner}" />
                                        <TextBlock Style="{StaticResource Shield}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                                        <CheckBox Content="{x:Static o:OptionLabels.CopyAuditing}" IsChecked="{Binding CopyAuditing}" Margin="0"
                                                  ToolTip="{x:Static o:OptionHelp.CopyAuditing}" />
                                        <TextBlock Style="{StaticResource Shield}" />
                                    </StackPanel>
                                </WrapPanel>
                                <WrapPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                                        <CheckBox Content="{x:Static o:OptionLabels.BackupMode}" IsChecked="{Binding BackupMode}" Margin="0"
                                                  ToolTip="{x:Static o:OptionHelp.BackupMode}" />
                                        <TextBlock Style="{StaticResource Shield}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                                        <CheckBox Content="{x:Static o:OptionLabels.RestartableBackup}" IsChecked="{Binding RestartableBackup}" Margin="0"
                                                  ToolTip="{x:Static o:OptionHelp.RestartableBackup}" />
                                        <TextBlock Style="{StaticResource Shield}" />
                                    </StackPanel>
                                </WrapPanel>
                                <WrapPanel>
                                    <CheckBox Content="{x:Static o:OptionLabels.SkipJunctions}" IsChecked="{Binding SkipJunctions}"
                                              ToolTip="{x:Static o:OptionHelp.SkipJunctions}" />
                                    <CheckBox Content="{x:Static o:OptionLabels.KeepFolderTimestamps}" IsChecked="{Binding KeepFolderTimestamps}"
                                              ToolTip="{x:Static o:OptionHelp.KeepFolderTimestamps}" />
                                </WrapPanel>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label Style="{StaticResource FieldLabel}" Content="{x:Static o:OptionLabels.ExcludeFiles}" Target="{Binding ElementName=ExcludeFilesBox}" Margin="0,0,10,6" />
                                    <TextBox x:Name="ExcludeFilesBox" Grid.Column="1" Margin="0,0,0,6" Text="{Binding ExcludeFiles, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                             ToolTip="{x:Static o:OptionHelp.ExcludeFiles}" AutomationProperties.Name="Exclude files" />
                                    <Label Grid.Row="1" Style="{StaticResource FieldLabel}" Content="{x:Static o:OptionLabels.ExcludeFolders}" Target="{Binding ElementName=ExcludeFoldersBox}" Margin="0,0,10,6" />
                                    <TextBox x:Name="ExcludeFoldersBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Text="{Binding ExcludeFolders, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                             ToolTip="{x:Static o:OptionHelp.ExcludeFolders}" AutomationProperties.Name="Exclude folders" />
                                    <Label Grid.Row="2" Style="{StaticResource FieldLabel}" Content="{x:Static o:OptionLabels.ExtraArguments}" Target="{Binding ElementName=ExtraArgumentsBox}" Margin="0,0,10,0" />
                                    <TextBox x:Name="ExtraArgumentsBox" Grid.Row="2" Grid.Column="1" FontFamily="{StaticResource Mono}"
                                             Text="{Binding ExtraArguments, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                             ToolTip="{x:Static o:OptionHelp.ExtraArguments}" AutomationProperties.Name="Extra arguments" />
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- 8. Command preview -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Command="{Binding CopyPreviewCommand}" ToolTip="Copy every robocopy command to the clipboard" AutomationProperties.Name="Copy commands">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <AccessText Text="Cop_y" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Command preview" VerticalAlignment="Center" Margin="0" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Note}" Text="{Binding PreviewMessage}"
                                       Visibility="{Binding PreviewMessage, Converter={StaticResource TextVis}}" />
                            <ItemsControl x:Name="PreviewList" ItemsSource="{Binding Preview}" AutomationProperties.Name="Command preview">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PreviewJobViewModel}">
                                        <TextBlock c:CommandText.Segments="{Binding Segments}" FontFamily="{StaticResource Mono}" FontSize="12.5"
                                                   TextWrapping="Wrap" Margin="0,0,0,8" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 9. Buttons -->
            <DockPanel Grid.Row="1" Margin="0,10,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Close" Command="{Binding CloseCommand}" IsCancel="True" />
                <Button DockPanel.Dock="Right" Command="{Binding StartCommand}" Style="{DynamicResource AccentButtonStyle}" MinWidth="96"
                        ToolTip="Run the commands shown in the preview" Margin="6,0,0,0" AutomationProperties.Name="Start">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA18;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Visibility="{Binding ShowStartShield, Converter={StaticResource Vis}}"
                                   ToolTip="An option that requires administrator rights is ticked; Windows will ask for permission." />
                        <AccessText Text="_Start" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Content="_Dry run" Command="{Binding DryRunCommand}"
                        ToolTip="Run the same commands with /L: list what would be copied or deleted without changing anything" />
            </DockPanel>
        </Grid>

        <!-- ═════════════════════════ RUNNING + RESULTS ═════════════════════════ -->
        <Grid Visibility="{Binding IsEditMode, Converter={StaticResource Vis}, ConverterParameter=invert}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Dry run banner -->
            <Border Grid.Row="0" CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                    Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                    BorderBrush="{DynamicResource SystemFillColorAttentionBrush}" BorderThickness="1"
                    Visibility="{Binding IsDryRunActive, Converter={StaticResource Vis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding DryRunBanner}" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <!-- Progress (running) -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Visibility="{Binding IsRunningMode, Converter={StaticResource Vis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding RunHeading}" />
                    <TextBlock Text="{Binding ScanText}" Visibility="{Binding IsScanning, Converter={StaticResource Vis}}" Margin="0,0,0,6" />
                    <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" IsIndeterminate="{Binding IsProgressIndeterminate}"
                                 AutomationProperties.Name="Overall progress" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding FilesText}" />
                        <TextBlock Grid.Column="1" Text="{Binding BytesText}" />
                        <TextBlock Grid.Column="2" Text="{Binding ElapsedText, StringFormat=Elapsed {0}}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Note}" Text="{Binding CurrentFileText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Summary (results) -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Visibility="{Binding IsResultsMode, Converter={StaticResource Vis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding ResultsHeading}" />
                    <TextBlock Text="{Binding ResultsTotalsText}" TextWrapping="Wrap" Visibility="{Binding ResultsTotalsText, Converter={StaticResource TextVis}}" />
                    <TextBlock Text="{Binding ResultsError}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Visibility="{Binding ResultsError, Converter={StaticResource TextVis}}" />
                    <TextBlock Text="{Binding CancelWarning}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Visibility="{Binding CancelWarning, Converter={StaticResource TextVis}}" />
                </StackPanel>
            </Border>

            <!-- Calls -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Robocopy calls" />
                    <ItemsControl ItemsSource="{Binding RunJobs}" MaxHeight="220" AutomationProperties.Name="Robocopy calls">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RunJobViewModel}">
                                <Grid Margin="0,0,0,8" ToolTip="{Binding CommandLine}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding StatusGlyph}" FontFamily="{StaticResource Icons}" VerticalAlignment="Top" Margin="0,2,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontWeight="SemiBold" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Visibility="{Binding ResultText, Converter={StaticResource TextVis}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding CountsText}" Style="{StaticResource Note}" Visibility="{Binding CountsText, Converter={StaticResource TextVis}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Output (running) / failed files (results) -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0">
                <Grid>
                    <DockPanel Visibility="{Binding IsRunningMode, Converter={StaticResource Vis}}">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Text="Output" />
                        <ListBox x:Name="OutputList" ItemsSource="{Binding OutputLines}" FontFamily="{StaticResource Mono}" FontSize="12"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Item"
                                 AutomationProperties.Name="Robocopy output">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="4,0" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>
                    <DockPanel Visibility="{Binding IsResultsMode, Converter={StaticResource Vis}}">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Text="{Binding FailedItems.Count, StringFormat=Failed items ({0})}" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Note}" Text="No files failed."
                                   Visibility="{Binding FailedItems.Count, Converter={StaticResource ZeroVis}}" />
                        <ListBox ItemsSource="{Binding FailedItems}" AutomationProperties.Name="Failed items">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Path}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FailedItemViewModel}">
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Note}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Buttons -->
            <DockPanel Grid.Row="4" Margin="0,10,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="_Cancel" Command="{Binding CancelCommand}" MinWidth="96"
                        Visibility="{Binding IsRunningMode, Converter={StaticResource Vis}}" ToolTip="Stop robocopy now" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsResultsMode, Converter={StaticResource Vis}}">
                    <Button Content="_Back to options" Command="{Binding BackToOptionsCommand}" ToolTip="Return to the options, for example to Start after a dry run" />
                    <Button Content="_Open log" Command="{Binding OpenLogCommand}" ToolTip="Open this run's log file" />
                    <Button Content="_Retry failed" Command="{Binding RetryFailedCommand}"
                            ToolTip="Run the same commands again; robocopy skips files that were already copied" />
                    <Button Content="Close" Command="{Binding CloseCommand}" Style="{DynamicResource AccentButtonStyle}"
                            IsCancel="{Binding IsResultsMode}" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
